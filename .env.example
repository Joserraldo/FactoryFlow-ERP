# FactoryFlow ERP — Environment Variables Template
# Copy this to .env and change the values

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=factoryflow

# Local database URL
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/factoryflow

# Security
SECRET_KEY=yoursecretkeyhere
REFRESH_SECRET_KEY=yourrefreshsecretkeyhere
ALGORITHM=HS256

# Configuration
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
